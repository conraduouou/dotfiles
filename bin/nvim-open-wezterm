#!/usr/bin/env bash

set -euo pipefail

tab_id=$(
    wezterm cli list --format json |
        jq -r --argjson pane "$WEZTERM_PANE" \
            '.[] | select(.pane_id == $pane) | .tab_id'
)

socket_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}/nvim"
socket="$socket_dir/wezterm-${tab_id}.sock"

mkdir -p "$socket_dir"

# If there are no arguments, start in the current pane
if [[ $# -eq 0 ]]; then
    exec nvim --listen "$socket"
fi

# Resolve absolute path of file sent,
# also track if there are no files in the command
actual_files=0
for file in "$@"; do
    if [[ "$file" = /* || "$file" = -* ]]; then
        args+=("$file")
    else
        args+=("$PWD/$file")
    fi

    if [[ "$file" != -* ]]; then
        actual_files=$(( actual_files + 1 ))
    fi
done

# If there weren't any files passed, just argument flags
# For example: nvim --help
if [[ "$actual_files" = 0 ]]; then
    exec nvim "$@"
fi

# If an Nvim instance is already listening on this socket,
# send the files to it.
if [[ -S "$socket" ]]; then
    exec nvim --server "$socket" --remote "${args[@]}"
fi

# No existing Nvim instance: create one in a new WezTerm pane.
pane_id="$(
    wezterm cli split-pane \
        --right \
        --cwd "$PWD" \
        -- nvim --listen "$socket" "$@"
)"

# Focus the newly created Nvim pane.
exec wezterm cli activate-pane --pane-id "$pane_id"
