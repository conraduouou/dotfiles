[
    // ============================================================
    // Jumps
    // ============================================================
    {
        "key": "ctrl+o",
        "command": "workbench.action.navigateBack",
        "when": "editorTextFocus && canNavigateBack"
    },
    {
        "key": "ctrl+shift+o",
        "command": "workbench.action.navigateForward",
        "when": "editorTextFocus && canNavigateForward"
    },

    // ============================================================
    // Diagnostics
    // ============================================================
    {
        "key": "ctrl+]",
        "command": "editor.action.marker.nextInFiles",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+]",
        "command": "editor.action.marker.prevInFiles",
        "when": "editorTextFocus"
    },

    // ============================================================
    // Buffer switching
    // ============================================================
    {
        "key": "ctrl+shift+h",
        "command": "workbench.action.previousEditor",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+l",
        "command": "workbench.action.nextEditor",
        "when": "editorTextFocus"
    },


    // ============================================================
    // Window navigation
    // ============================================================
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight"
    },

    // ============================================================
    // Insert mode navigation
    // ============================================================
    {
        "key": "ctrl+h",
        "command": "vscode-neovim.send",
        "args": "<C-h>",
        "when":"editorTextFocus && neovim.mode == 'insert'"
    },
    {
        "key": "ctrl+j",
        "command": "vscode-neovim.send",
        "args": "<C-j>",
        "when":"editorTextFocus && neovim.mode == 'insert'"
    },
    {
        "key": "ctrl+k",
        "command": "vscode-neovim.send",
        "args": "<C-k>",
        "when":"editorTextFocus && neovim.mode == 'insert'"
    },
    {
        "key": "ctrl+l",
        "command": "vscode-neovim.send",
        "args": "<C-l>",
        "when":"editorTextFocus && neovim.mode == 'insert'"
    },
    
    // ============================================================
    // VSCode operations
    // ============================================================
    {
        "key": "ctrl+b w",
        "command": "workbench.action.closeActiveEditor",
        "when": "!editorTextFocus && !filesExplorerFocus && !searchViewletFocus && !terminalFocus && neovim.mode != 'cmdline'"
    },
    {
        "key": "ctrl+b e",
        "command": "workbench.view.explorer"
    },
    {
        "key": "ctrl+b o",
        "command": "workbench.action.output.toggleOutput"
    },
    {
        "key": "ctrl+b t",
        "command": "workbench.action.terminal.toggleTerminal"
    },
    {
        "key": "ctrl+b d",
        "command": "workbench.actions.view.problems"
    },
    {
        "key": "ctrl+b a",
        "command": "workbench.action.chat.open"
    },
    {
        "key": "ctrl+b x",
        "command": "workbench.action.closePanel",
        "when": "panelFocus"
    },
    {
        "key": "ctrl+b x",
        "command": "workbench.action.closeSidebar",
        "when": "sideBarFocus"
    },
    {
        "key": "ctrl+b x",
        "command": "workbench.action.closeAuxiliaryBar",
        "when": "auxiliaryBarFocus"
    },
    {
        "key": "ctrl+b shift+x",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.closePanel",
                "workbench.action.closeSidebar",
                "workbench.action.closeAuxiliaryBar"
            ]
        }
    },
    {
        "key": "shift+j",
        "command": "list.expandSelectionDown",
        "when": "listFocus && listSupportsMultiselect && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "shift+k",
        "command": "list.expandSelectionUp",
        "when": "listFocus && listSupportsMultiselect && !inputFocus && !treestickyScrollFocused"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    },
    {
        "key": "space",
        "command": "list.toggleSelection",
        "when": "filesExplorerFocus && !inputFocus"
    },

    // ============================================================
    // Completion
    // ============================================================
    {
        "key": "enter",
        "command": "acceptSelectedSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible"
    },
    {
        "key": "enter",
        "command": "editor.action.inlineSuggest.commit",
        "when": "editorTextFocus && inlineSuggestionVisible"
    },
    {
        "key": "tab",
        "command": "selectNextSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible"
    },
    {
        "key": "shift+tab",
        "command": "selectPrevSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible"
    },
    {
        "key": "ctrl+j",
        "command": "selectNextSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible"
    },
    {
        "key": "ctrl+k",
        "command": "selectPrevSuggestion",
        "when": "editorTextFocus && suggestWidgetVisible"
    },
    {
        "key": "ctrl+e",
        "command": "editor.action.scrollDownHover",
        "when": "editorTextFocus && suggestWidgetVisible"
    },
    {
        "key": "ctrl+y",
        "command": "editor.action.scrollUpHover",
        "when": "editorTextFocus && suggestWidgetVisible"
    },
    {
        "key": "ctrl+,",
        "command": "editor.action.triggerSuggest",
        "when": "editorTextFocus && !suggestWidgetVisible"
    },
    {
        "key": "ctrl+,",
        "command": "toggleSuggestionDetails",
        "when": "editorTextFocus && suggestWidgetVisible"
    },

    // ============================================================
    // Resizing
    // ============================================================
    {
        "key": "ctrl+`",
        "command": "workbench.action.increaseViewSize"
    },
    {
        "key": "ctrl+shift+`",
        "command": "workbench.action.decreaseViewSize"
    },

    // ============================================================
    // Terminal Navigation
    // ============================================================
    {
        "key": "ctrl+shift+k",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+j",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+b ;",
        "command": "workbench.action.terminal.split",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+b t",
        "command": "workbench.action.terminal.new",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+b backspace",
        "command": "workbench.action.terminal.kill",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.terminal.focusNextPane",
        "when": "terminalFocus && terminalHasBeenCreated && terminalSplitPaneActive || terminalFocus && terminalProcessSupported && terminalSplitPaneActive"
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.terminal.focusPreviousPane",
        "when": "terminalFocus && terminalHasBeenCreated && terminalSplitPaneActive || terminalFocus && terminalProcessSupported && terminalSplitPaneActive"
    },
    {
        "key": "ctrl+shift+u",
        "command": "workbench.action.terminal.selectToPreviousCommand",
        "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
    },
    {
        "key": "ctrl+shift+d",
        "command": "workbench.action.terminal.selectToNextCommand",
        "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
    },
    {
        "key": "ctrl+d",
        "command": "workbench.action.terminal.scrollToNextCommand",
        "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled"
    },
    {
        "key": "ctrl+u",
        "command": "workbench.action.terminal.scrollToPreviousCommand",
        "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled"
    },
    {
        "key": "y",
        "command": "runCommands",
        "args": {
            "commands": [
                "workbench.action.terminal.copySelection",
                "workbench.action.terminal.clearSelection",
                "workbench.action.terminal.focus"
            ]
        },
        "when": "terminalFocus && terminalTextSelected"
    }
]